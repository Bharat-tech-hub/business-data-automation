# Virtual environment
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Data (large or user-supplied; never commit raw data)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated outputs
reports/*
!reports/.gitkeep
logs/*
!logs/.gitkeep

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Secrets and local config
.env
*.local
